# Telegram — token from @BotFather. Leave OWNER_CHAT_ID empty, message the bot once,
# it replies with your chat ID; paste it here and restart.
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=

# Azure OpenAI (same values as jobsource_agent)
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_MODEL=gpt-5.6-terra-1
AZURE_OPENAI_API_KEY=

# Resend — until mail.thalesops.com is verified, onboarding@resend.dev only
# delivers to the email address of your Resend account.
RESEND_API_KEY=
EMAIL_FROM=Opportunity Reminder <onboarding@resend.dev>
# One or more addresses, comma-separated
EMAIL_TO=

TIMEZONE=Africa/Kigali
REMINDER_HOUR=8
DIGEST_HOUR=18
DB_PATH=data/reminders.db
